# Copy to private-ai-backend/.env on the VPS, replace placeholders, and chmod 600.
# Never commit the populated .env file or paste its values into logs/issues.
APP_ENV=production
BACKEND_IMAGE=truefox-ai/private-ai-backend:local
DATABASE_PATH=/app/data/truefox.sqlite3
FRONTEND_ORIGINS=https://truefoxaiinc.com,https://www.truefoxaiinc.com
# Required: set to the observed Docker bridge peer address/CIDR used by Apache.
TRUSTED_PROXY_IPS=REPLACE_WITH_OBSERVED_PROXY_PEER_CIDR
OPENROUTER_API_KEY=REPLACE_WITH_NEW_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-small
ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
MOCK_LLM=false
LOG_USER_MESSAGES=false
