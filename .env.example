APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/rag.sqlite3
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
ADMIN_TOKEN_MINUTES=480
ADMIN_JWT_ISSUER=truefox-ai-api
ADMIN_JWT_AUDIENCE=truefox-ai-admin
ADMIN_COOKIE_DOMAIN=.truefoxaiinc.com
LEADS_WEBHOOK_URL=
COMPANY_SITE_URL=https://truefoxaiinc.com
FRONTEND_ORIGINS=http://localhost:3000
OPENROUTER_API_KEY=replace-with-a-new-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=512
RAG_TOP_K=3
RAG_MIN_SCORE=0.32
MAX_CONTEXT_CHARS=6000
CHAT_RATE_LIMIT_PER_MINUTE=20
MOCK_LLM=false
LOG_USER_MESSAGES=false
